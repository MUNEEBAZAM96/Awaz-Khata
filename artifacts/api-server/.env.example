# Template for local development secrets. Copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. On Replit these values come from Secrets instead —
# nothing here is read in that environment.
#
# Load it with:  pnpm --filter @workspace/api-server run dev:local

# Uplift AI — Urdu speech-to-text + text-to-speech. Required for the voice loop.
UPLIFTAI_API_KEY=

# Groq (gsk_...) or OpenAI key — intent extraction. Provider is auto-detected.
LLM_API_KEY=

# Optional overrides.
# UPLIFTAI_VOICE_ID=v_meklc281
# LLM_PROVIDER=
# LLM_MODEL=

# Port for the local API server. 8080 is taken by nginx on this machine.
# Must match EXPO_PUBLIC_API_URL passed to the Expo app.
PORT=8000
