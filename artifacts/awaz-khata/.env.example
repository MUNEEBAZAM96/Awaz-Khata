# Awaz Khata — mobile app environment.
#
# Copy to `.env` (gitignored) for local development, or set these as Replit
# Secrets. Everything here is EXPO_PUBLIC_*, which means it is inlined into the
# shipped JavaScript bundle and is readable by anyone with the app.
#
# NEVER put a secret in this file. In particular CLERK_SECRET_KEY,
# UPLIFTAI_API_KEY and LLM_API_KEY are backend-only credentials and must stay
# on the API server.

# --- API server ---------------------------------------------------------
# Full origin, local dev only. A phone on Expo Go needs the LAN IP of the
# machine running the API server — `localhost` resolves to the phone itself.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
#
# On Replit the workflow sets EXPO_PUBLIC_DOMAIN automatically.

# --- Clerk --------------------------------------------------------------
# Required. Publishable key from the Clerk Dashboard (API keys). Safe to ship.
# Test instances start `pk_test_`, production `pk_live_`.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y3V0ZS1idWxsZG9nLTk0LmNsZXJrLmFjY291bnRzLmRldiQ

# --- Native Google Sign-In ----------------------------------------------
# Only needed for the native Google flow, which requires a development build
# (it does not work in Expo Go). Values come from Google Cloud Console
# OAuth 2.0 client IDs; client IDs are public identifiers, not secrets.
#
# Both platforms need the *Web* client ID — it is the audience Clerk verifies.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=

# iOS
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# Android
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
